import { useState } from "react";
import type { PageName } from "@/lib/types";
import Sidebar from "@/components/Sidebar";
import Header from "@/components/Header";
import Dashboard from "@/pages/Dashboard";
import Proposals from "@/pages/Proposals";
import PlaceholderPage from "@/pages/PlaceholderPage";

const pageTitles: Record<PageName, { title: string; subtitle: string }> = {
  dashboard: { title: "Dashboard", subtitle: "Visão geral do sistema" },
  clientes: { title: "Cadastro de Clientes", subtitle: "Gerencie a base de clientes" },
  produtos: { title: "Cadastro de Produtos", subtitle: "Catálogo de produtos e serviços" },
  orcamento: { title: "Lançamento / Orçamento", subtitle: "Criação e edição de orçamentos" },
  "os-diaria": { title: "OS Diária", subtitle: "Ordens de serviço do dia" },
  "forca-vendas": { title: "Força de Vendas", subtitle: "Pipeline e indicadores de vendas" },
  propostas: { title: "Relatórios & Propostas", subtitle: "Emissão de propostas e etiquetas técnicas" },
  "codigo-php": { title: "Código PHP/MySQL", subtitle: "Integração e scripts legados" },
};

const placeholderTitles: Partial<Record<PageName, string>> = {
  clientes: "Cadastro de Clientes",
  produtos: "Cadastro de Produtos",
  orcamento: "Lançamento / Orçamento",
  "os-diaria": "OS Diária",
  "forca-vendas": "Força de Vendas",
  "codigo-php": "Código PHP/MySQL",
};

export default function App() {
  const [currentPage, setCurrentPage] = useState<PageName>("propostas");
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);

  const { title, subtitle } = pageTitles[currentPage];

  return (
    <div className="flex h-screen bg-slate-950 overflow-hidden">
      <Sidebar
        currentPage={currentPage}
        onNavigate={setCurrentPage}
        collapsed={sidebarCollapsed}
      />
      <div className="flex flex-col flex-1 min-w-0 overflow-hidden">
        <Header
          title={title}
          subtitle={subtitle}
          onToggleSidebar={() => setSidebarCollapsed((v) => !v)}
        />
        <main className="flex-1 overflow-auto flex flex-col min-h-0">
          {currentPage === "dashboard" && <Dashboard />}
          {currentPage === "propostas" && <Proposals />}
          {currentPage in placeholderTitles && currentPage !== "propostas" && (
            <PlaceholderPage title={placeholderTitles[currentPage]!} />
          )}
        </main>
      </div>
    </div>
  );
}
